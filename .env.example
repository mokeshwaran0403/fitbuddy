# ==========================================
# FitBuddy - Environment Configuration
# ==========================================

# Google Gemini API Key
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# AI Models (Configurable to prevent obsolescence)
# Complex Workout Planning Model (Default: gemini-1.5-pro or gemini-2.5-flash)
GEMINI_WORKOUT_MODEL=gemini-1.5-pro

# Fast Nutrition & Recovery Model (Default: gemini-1.5-flash or gemini-2.5-flash)
GEMINI_FAST_MODEL=gemini-1.5-flash

# Database Configuration
DATABASE_URL=sqlite:///./fitbuddy.db

# Server Configuration
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True

# Admin Dashboard Access
ADMIN_SECRET_KEY=fitbuddy-admin-secret-2025
